# ================================================================================
# ARTAgent Environment Configuration Template
# ================================================================================
# Copy this file to .env and fill in your values
# This file documents all available configuration options for local and cloud deployment

# ================================================================================
# APPLICATION SETTINGS
# ================================================================================
ENVIRONMENT=development
DEBUG_MODE=true
BASE_URL=http://localhost:8010

# Port Configuration
BACKEND_PORT=8010
FRONTEND_PORT=8080
PORT=8010

# ================================================================================
# DATABASE CONFIGURATION (PostgreSQL for Tool Registry)
# ================================================================================
# PostgreSQL is used for the Tool Registry platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=artagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/artagent

# ================================================================================
# OPTIONAL: AZURE COSMOS DB (MongoDB API) - For advanced features
# ================================================================================
# Cosmos DB is optional - leave empty for local development
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_DATABASE_NAME=
AZURE_COSMOS_COLLECTION_NAME=

# ================================================================================
# OPTIONAL: REDIS CACHE - For session management
# ================================================================================
# Redis is optional - the app will run without it
AZURE_REDIS_HOST=
AZURE_REDIS_PORT=6379
AZURE_REDIS_PASSWORD=
AZURE_REDIS_SSL=false

# ================================================================================
# AZURE OPENAI CONFIGURATION (Required for AI features)
# ================================================================================
# Get these from your Azure OpenAI resource in Azure Portal
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT_ID=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_VERSION=2024-11-20

# ================================================================================
# AZURE SPEECH SERVICES (Required for voice features)
# ================================================================================
# Get these from your Azure Speech Services resource
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_RESOURCE_ID=

# Alternative names (for compatibility)
AZURE_OPENAI_STT_TTS_ENDPOINT=
AZURE_OPENAI_STT_TTS_KEY=

# ================================================================================
# AZURE COMMUNICATION SERVICES (Required for telephony)
# ================================================================================
# Get these from your Azure Communication Services resource
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
ACS_SOURCE_PHONE_NUMBER=
ACS_STREAMING_MODE=media
ACS_AUDIENCE=

# ================================================================================
# AZURE STORAGE (Optional - for recordings)
# ================================================================================
AZURE_STORAGE_CONTAINER_URL=

# ================================================================================
# AUTHENTICATION & AUTHORIZATION
# ================================================================================
# Entra ID (Azure AD) Configuration
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
BACKEND_AUTH_CLIENT_ID=
ALLOWED_CLIENT_IDS=

# Enable/disable authentication (set to false for local development)
ENABLE_AUTH_VALIDATION=false

# ================================================================================
# CORS CONFIGURATION
# ================================================================================
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:8010

# ================================================================================
# VOICE & SPEECH SETTINGS
# ================================================================================
# Voice configuration
DEFAULT_VOICE=en-US-JennyNeural
GREETING_VOICE_TTS=Hello! I'm your voice assistant. How can I help you today?

# Speech recognition settings
RECOGNIZED_LANGUAGE=en-US
AUDIO_FORMAT=pcm16
VAD_SEMANTIC_SEGMENTATION=true
SILENCE_DURATION_MS=1000

# ================================================================================
# POOL CONFIGURATION (Resource management)
# ================================================================================
POOL_SIZE_TTS=10
POOL_SIZE_STT=10
MAX_WEBSOCKET_CONNECTIONS=100
CONNECTION_TIMEOUT_SECONDS=300

# ================================================================================
# FEATURE FLAGS
# ================================================================================
ENABLE_DOCS=true
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
SECURE_DOCS_URL=/secure-docs

# ================================================================================
# TELEMETRY & MONITORING
# ================================================================================
# Set to true to disable cloud telemetry for local development
DISABLE_CLOUD_TELEMETRY=true

# Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ================================================================================
# AGENT CONFIGURATION
# ================================================================================
# Paths to agent configuration files (relative to project root)
AGENT_AUTH_CONFIG=src/agents/artagent/agent_store/auth_agent.yaml
AGENT_CLAIM_INTAKE_CONFIG=src/agents/artagent/agent_store/claim_intake_agent.yaml
AGENT_GENERAL_INFO_CONFIG=src/agents/artagent/agent_store/general_info_agent.yaml

# ================================================================================
# DEPLOYMENT & CI/CD INTEGRATION POINTS
# ================================================================================
# These are placeholders for production deployment
# Uncomment and configure when deploying to cloud environments

# Azure Key Vault (for production secrets)
# AZURE_KEY_VAULT_NAME=
# AZURE_KEY_VAULT_ENDPOINT=

# Container Registry (for CI/CD)
# CONTAINER_REGISTRY=
# CONTAINER_REGISTRY_USERNAME=
# CONTAINER_REGISTRY_PASSWORD=

# Deployment environment tags
# DEPLOYMENT_ENVIRONMENT=production
# DEPLOYMENT_REGION=eastus
# DEPLOYMENT_VERSION=1.0.0
